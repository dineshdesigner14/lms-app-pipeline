version: 0.2

env:
  variables:
    EC2_USER: ec2-user
    EC2_HOST: "13.126.27.54"

    # Application config
    APP_NAME: lmsapieng
    APP_PORT: "4008"

  secrets-manager:
    EC2_SSH_KEY: "lms/ec2/sshkey"

phases:
  install:
    runtime-versions:
      golang: 1.21

  build:
    commands:
      - echo "Building binary for lmsapieng on port 4008"

      # application_port.no naming
      - export BIN_FILE_NAME=${APP_NAME}_${APP_PORT}
      - echo "Binary name: $BIN_FILE_NAME"

      # Build Go binary
      - go build -tags lms-api-eng -o $BIN_FILE_NAME

      # Prepare SSH key
      - echo "$EC2_SSH_KEY" > key.pem
      - chmod 600 key.pem

      # Copy binary to EC2
      - scp -o StrictHostKeyChecking=no -i key.pem \
          $BIN_FILE_NAME $EC2_USER@$EC2_HOST:/tmp/

      - scp -o StrictHostKeyChecking=no -i key.pem \
          deploy.sh $EC2_USER@$EC2_HOST:/home/ec2-user/LMS_DEV

      # Trigger deployment on EC2
      - |
        ssh -o StrictHostKeyChecking=no -i key.pem \
        $EC2_USER@$EC2_HOST << EOF
          cd /home/ec2-user/LMS_DEV
          chmod +x deploy.sh
          ./deploy.sh
        EOF

artifacts:
  files:
    - '**/*'
